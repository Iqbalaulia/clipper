# Application security (required in production)
SECRET_KEY=replace-with-a-stable-random-secret
JWT_SECRET_KEY=replace-with-a-different-stable-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-fernet-key-or-long-random-secret
PUBLIC_BASE_URL=http://localhost:5000
JWT_COOKIE_SECURE=false

# Social login. Configure any combination.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# S3-compatible storage: AWS S3, Cloudflare R2, Wasabi, or MinIO.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_EXPIRES=900

# Midtrans Snap
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Existing email and worker settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=false
CLIPPER_MAX_WORKERS=2
CLIPPER_TASK_TIMEOUT=3600
